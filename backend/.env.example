# Copy to .env and fill in. Use a read-only DB role.
PGHOST=localhost
PGPORT=5432
PGDATABASE=llcc
PGUSER=your_db_user
PGPASSWORD=

# Schema the UI reads from (the clean "System 5" tables)
DB_SCHEMA=public

PORT=4100

# Dashboard login (single shared account, no roles)
APP_USERNAME=admin
APP_PASSWORD=change-me
APP_SECRET=change-me-to-a-long-random-string

# postgres superuser, only for npm run seed
SEED_PASSWORD=
