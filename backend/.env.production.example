# for the server. copy this to .env
# use a read only db user
DATABASE_URL=postgres://readonly_user:PASSWORD@DB_HOST:5432/llcc

# set to true if ssl is needed
PGSSL=true

DB_SCHEMA=public

PORT=4100

# Dashboard login (single shared account, no roles)
APP_USERNAME=admin
APP_PASSWORD=set-a-strong-password
APP_SECRET=set-a-long-random-string
